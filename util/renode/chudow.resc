using sysbus
$name?="chudow"
mach create $name

$repl?=@platforms/cpus/focaltech_ft9001.repl
machine LoadPlatformDescription $repl
machine LoadPlatformDescriptionFromString "romfuncs: Memory.MappedMemory @ sysbus 0x04006000 { size: 0x2000 }"

$bin?=$ORIGIN/chudow/ec.bin
$elf_ro?=$ORIGIN/chudow/ec.RO.elf
$elf_rw?=$ORIGIN/chudow/ec.RW.elf

# USART3 is not included in upstream Renode
# (https://github.com/renode/renode/blob/master/platforms/cpus/focaltech_ft9001.repl),
# so we add it here.
# Address and IRQ come from
# https://source.chromium.org/chromiumos/chromiumos/codesearch/+/main:src/third_party/zephyrproject/zephyr/dts/arm/focaltech/ft9001/ft9001.dtsi;l=95-102;drc=07db2d60da7db0c0f568842bec3aaf221d727281.
machine LoadPlatformDescriptionFromString "usart3: UART.FT9001_USART @ sysbus 0x4001d000 { IRQ -> nvic0@61 }"

showAnalyzer usart3

set mock_rom_func
"""
self.Log(LogLevel.Debug, "mocking ROM function")
cpu.PC = cpu.LR  # Return immediately
"""

macro reset
"""
    # ROM functions
    cpu0 AddHook 0x4007658 $mock_rom_func  # `xip_sys_clk_switch`
    cpu0 AddHook 0x400665C $mock_rom_func  # `ssi_close_xip`

    cpu0 FpuEnabled true
    sysbus LoadBinary $bin 0x10080000
    sysbus LoadSymbolsFrom $elf_ro
    sysbus LoadSymbolsFrom $elf_rw
    cpu0 VectorTableOffset 0x10081000  # Vector table of RO image
"""

runMacro $reset
