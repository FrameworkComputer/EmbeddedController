if SOC_SERIES_FT90

DT_CHOSEN_Z_SRAM := zephyr,sram

config CROS_EC_RAM_BASE
	default SRAM_BASE_ADDRESS

config CROS_EC_DATA_RAM_SIZE
	default $(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_SRAM))

config CROS_EC_RAM_SIZE
	default $(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_SRAM))

config CROS_EC_PROGRAM_MEMORY_BASE
	default FLASH_BASE_ADDRESS

# The firmware binary is placed after bootloader blob
config CROS_EC_FIRMWARE_LOAD_OFF
	default $(dt_nodelabel_reg_size_hex,bootloader)

config CROS_EC_RO_MEM_OFF
	default $(add_hex, $(dt_node_int_prop_hex,/binman/wp-ro/ec-ro,offset), \
			   $(dt_nodelabel_reg_size_hex,bootloader))

config CROS_EC_RO_SIZE
	default $(dt_node_int_prop_hex,/binman/wp-ro/ec-ro,size)

config CROS_EC_RW_MEM_OFF
	default $(add_hex, $(dt_node_int_prop_hex,/binman/ec-rw,offset), \
			   $(dt_nodelabel_reg_size_hex,bootloader))

# Tell the linker where the RO/RW part starts.
config FLASH_LOAD_OFFSET
	default CROS_EC_RO_MEM_OFF if CROS_EC_RO
	default CROS_EC_RW_MEM_OFF if CROS_EC_RW

# Tell the linker is it can use flash till the end.
config FLASH_LOAD_SIZE
	default CROS_EC_RO_SIZE if CROS_EC_RO
	default CROS_EC_RW_SIZE if CROS_EC_RW

endif # SOC_SERIES_FT90
