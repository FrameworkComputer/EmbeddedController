/ {
	named-i2c-ports {
		compatible = "named-i2c-ports";

		i2c_named_i2c_port_pd: named_i2c_port_pd_aic {
			i2c-port = <&i2c_port_pd>;
			enum-names = "I2C_PORT_PD";
		};
		i2c_named_i2c_port_charger: named_i2c_port_charger {
			i2c-port = <&i2c_port_charger>;
			enum-names = "I2C_PORT_BATTERY",
				"I2C_PORT_CHARGER",
				"I2C_PORT_PORT80";
		};
	};
};

&i2c_port_pd {
	label = "I2C_PORT_PD";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&i2c_port_charger {
	label = "I2C_PORT_CHARGER";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};
