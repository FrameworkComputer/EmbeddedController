&i2c_port_pd {
	pdc_ti_c0: tps6699-pdc@20 {
		compatible = "ti,tps6699-pdc";
		reg = <0x20>;
		port-index-on-chip = <0x1>;
		frs-supported;
	};
	pdc_ti_c1: tps6699-pdc@24 {
		compatible = "ti,tps6699-pdc";
		reg = <0x24>;
		port-index-on-chip = <0x2>;
		frs-supported;
		no-fw-update;
		ccd;
	};
	pdc_ti_c2: tps6699-pdc@21 {
		compatible = "ti,tps6699-pdc";
		reg = <0x21>;
		port-index-on-chip = <0x1>;
		frs-supported;
	};
};
