#include <cros/thermistor/thermistor.dtsi>

/ {
	named-adc-channels {

		adc_temp_backcov: backcov {
			enum-name = "ADC_TEMP_SENSOR_1";
			io-channels = <&adc0 0>;
		};
		adc_temp_keyboard: keyboard {
			enum-name = "ADC_TEMP_SENSOR_2";
			io-channels = <&adc0 1>;
		};
		adc_temp_cpu: cpu {
			enum-name = "ADC_TEMP_SENSOR_3";
			io-channels = <&adc0 2>;
		};
		adc_temp_wlan: wlan {
			enum-name = "ADC_TEMP_SENSOR_4";
			io-channels = <&adc0 3>;
		};
		adc_temp_qtm_r: qtm_r {
			enum-name = "ADC_TEMP_SENSOR_5";
			io-channels = <&adc0 4>;
		};
		adc_temp_charger: charger {
			enum-name = "ADC_TEMP_SENSOR_6";
			io-channels = <&adc0 5>;
		};
		adc_temp_qtm_l: qtm_l {
			enum-name = "ADC_TEMP_SENSOR_7";
			io-channels = <&adc0 6>;
		};
		adc_temp_usb: usb {
			enum-name = "ADC_TEMP_SENSOR_8";
			io-channels = <&adc0 7>;
		};
	};

	temp_sensor_backcov: backcov {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_backcov>;
	};
	temp_sensor_keyboard: keyboard {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_keyboard>;
	};
	temp_sensor_cpu: cpu {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_cpu>;
	};
	temp_sensor_wlan: wlan {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_wlan>;
	};
	temp_sensor_qtm_r: qtm_r {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_qtm_r>;
	};
	temp_sensor_charger: charger {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_charger>;
	};
	temp_sensor_qtm_l: qtm_l {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_qtm_l>;
	};
	temp_sensor_usb: usb {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_usb>;
	};

	named-temp-sensors {
		compatible = "cros-ec,temp-sensors";
		temp_backcov: backcov {
			sensor = <&temp_sensor_backcov>;
		};
		temp_keyboard: keyboard {
			sensor = <&temp_sensor_keyboard>;
		};
		temp_cpu: cpu {
			sensor = <&temp_sensor_cpu>;
		};
		temp_wlan: wlan {
			sensor = <&temp_sensor_wlan>;
		};
		temp_qtm_r: qtm_r {
			sensor = <&temp_sensor_qtm_r>;
		};
		temp_charger: charger {
			sensor = <&temp_sensor_charger>;
		};
		temp_qtm_l: qtm_l {
			sensor = <&temp_sensor_qtm_l>;
		};
		temp_usb: usb {
			sensor = <&temp_sensor_usb>;
		};
	};
};

&thermistor_3V3_100K_100K_4250B {
	status = "okay";
};

&adc0 {
	pinctrl-0 = <&adc0_chan0_gp45
		&adc0_chan1_gp44
		&adc0_chan2_gp43
		&adc0_chan3_gp42
		&adc0_chan4_gp41
		&adc0_chan5_gp37
		&adc0_chan6_gp34
		&adc0_chan7_gpe1>;
	pinctrl-names = "default";
};
