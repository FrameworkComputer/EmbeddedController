&ulpm {
	status = "okay";

	/* lid: (gpioh 0) */
	wkup-pin@0 {
		reg = <0x0>;
		wkup-pin-pol = "rising";
		wkup-pin-mode = "vin";
	};

	wkup-pin@1 {
		reg = <0x1>;
		wkup-pin-pol = "falling";
		wkup-pin-mode = "gpio";
	};

	wkup-pin@2 {
		reg = <0x2>;
		wkup-pin-pol = "falling";
		wkup-pin-mode = "gpio";
	};

	/* power button (gpioh 3) */
	wkup-pin@3 {
		reg = <0x3>;
		wkup-pin-pol = "falling";
		wkup-pin-mode = "vin";
	};

	/* ac (gpioh 5) */
	wkup-pin@5 {
		reg = <0x5>;
		wkup-pin-pol = "rising";
		wkup-pin-mode = "vin";
	};
};
