/ {
	fans {
		compatible = "cros-ec,fans";

		fan0: fan_0 {
			pwms = <&pwm5 PWM_CHANNEL_5 PWM_KHZ(25) PWM_POLARITY_NORMAL>;
			rpm-min = <2500>;
			rpm-start = <2500>;
			rpm-max = <6000>;
			tach = <&tach0>;
			rpm-deviation = <1>;
			pgood-gpio = <&gpio_all_sys_pg>;
			enable-gpio = <&gpio_en_pp5000_fan>;
		};
		fan1: fan_1 {
			pwms = <&pwm4 PWM_CHANNEL_4 PWM_KHZ(25) PWM_POLARITY_NORMAL>;
			rpm-min = <2500>;
			rpm-start = <2500>;
			rpm-max = <6000>;
			tach = <&tach1>;
			rpm-deviation = <1>;
			pgood-gpio = <&gpio_all_sys_pg>;
			enable-gpio = <&gpio_en_pp5000_fan>;
		};
	};

	fan_steps: fan-steps {
		compatible = "cros-ec,fan-steps";
		level_0 {
			temp-on = <37 0 0>;
			temp-off = <99 0 0>;
			rpm-target = <0 0>;
		};
		level_1 {
			temp-on = <40 0 0>;
			temp-off = <33 0 0>;
			rpm-target = <3200 3200>;
		};
		level_2 {
			temp-on = <43 0 0>;
			temp-off = <36 0 0>;
			rpm-target = <3500 3500>;
		};
		level_3 {
			temp-on = <46 0 0>;
			temp-off = <39 0 0>;
			rpm-target = <4000 4000>;
		};
		level_4 {
			temp-on = <49 0 0>;
			temp-off = <42 0 0>;
			rpm-target = <4400 4400>;
		};
		level_5 {
			temp-on = <52 0 0>;
			temp-off = <45 0 0>;
			rpm-target = <4700 4700>;
		};
		level_6 {
			temp-on = <55 0 0>;
			temp-off = <48 0 0>;
			rpm-target = <5200 5200>;
		};
		level_7 {
			temp-on = <100 0 0>;
			temp-off = <51 0 0>;
			rpm-target = <5700 5700>;
		};
	};
};

&pwm4 {
	status = "okay";
	prescaler-cx = <PWM_PRESCALER_C6>;
	pinctrl-0 = <&pwm4_gpa4_default>;
	pinctrl-names = "default";
};

&pwm5 {
	status = "okay";
	prescaler-cx = <PWM_PRESCALER_C6>;
	pinctrl-0 = <&pwm5_gpa5_default>;
	pinctrl-names = "default";
};

&tach0 {
	status = "okay";
	pinctrl-0 = <&tach0a_gpd6_default>;
	pinctrl-names = "default";
	channel = <IT8XXX2_TACH_CHANNEL_A>;
	pulses-per-round = <2>;
};

&tach1 {
	status = "okay";
	pinctrl-0 = <&tach1a_gpd7_default>;
	pinctrl-names = "default";
	channel = <IT8XXX2_TACH_CHANNEL_A>;
	pulses-per-round = <2>;
};
