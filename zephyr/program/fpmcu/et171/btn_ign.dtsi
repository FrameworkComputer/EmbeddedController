/ {
	aliases {
		gpio-btn-ign-out = &gpio_btn_ign_out;
	};

	named-gpios {
		compatible = "named-gpios";

		gpio_btn_ign_out: gpio_btn_ign_out {
			gpios = <&gpio0 2 GPIO_OUTPUT_INACTIVE>;
		};
	};
};
