#include <cros/egis/et171.dtsi>

/delete-node/ &sram;

/ {
	chosen {
		cros-ec,bbram = &bbram;
	};

	sdcp: memory@0 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x00000000 256>;
	};

	memory@100 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x100 32>;
		zephyr,memory-region = "RetainedMem";
		status = "okay";

		bbram: retained-ram {
			compatible = "zephyr,retained-ram";
			status = "okay";
			#address-cells = <1>;
			#size-cells = <1>;
		};
	};

	sram: memory@400 {
		device_type = "memory";
		compatible = "mmio-sram";
		/* Round down to kB, because the SRAM_SIZE config uses kB as SRAM
		 * size
		 */
		reg = <0x00000400 DT_SIZE_K(383)>;
	};

	sdcp_h_f: memory@90000000 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x90000000 32>;
	};

	sdcp_s_d: memory@90000020 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x90000020 64>;
	};

	sdcp_pk_f: memory@90000060 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x90000060 65>;
	};

	sdcp_sk_f: memory@900000a1 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x900000a1 32>;
	};
};

&spi0 {
	status = "okay";
	clock-frequency = <100000000>;
};

&spi1 {
	status = "okay";
	clock-frequency = <100000000>;
};

&syscon {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	/delete-property/ clock-frequency;
};

&clock {
	ahb-divide = <2>;
	apb-divide = <1>;
};
