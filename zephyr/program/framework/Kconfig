# Project Configuration
config CHIPSET_INTEL
	bool "Framework Intel project"
	default n
	help
	  Framework project which uses the Intel chipset.
	  Enable the Intel feature.

config CHIPSET_AMD
	bool "Framework AMD project"
	default n
	help
	  Framework project which uses the AMD chipset.
	  Enable the AMD feature.

config PD_USB_PID
	hex "PD Controller's USB PID"
	default 0x0001
	help
		The USB Product ID (PID) of the PD controller
		Default is the one we used on 11th Gen and forgot to update on every project since.

config PD_CHIP_CCG8
	bool "Select CCG8 PD chip"
	default n
	help
	  Framework project which uses the CCG8 PD chips.
	  Enable CCG8 PD feature.

config PD_CCG8_EPR
	bool "Enable Cypress CCG8 EPR"
	default n
	depends on PD_CHIP_CCG8
	help
		Support Cypress CCG8 EPR function, this featurn can
		support more higer powerful adp.

config PD_CHIP_CCG6
	bool "Select CCG6 PD chip"
	default n
	help
	  Framework project which uses the CCG6 PD chips.
	  Enable CCG6 PD feature.

config PD_CCG6_EC_UART_DEBUG_PORT
	int "EC uart debug port"
	default 0
	depends on PD_CHIP_CCG6
	help
		EC needs to switch the external mux to turn on the path for EC
		uart.

config PD_CCG6_SOC_UART_DEBUG_PORT
	int "SoC uart debug port"
	default 1
	depends on PD_CHIP_CCG6
	help
		EC needs to switch the external mux to turn on the path for SoC
		uart.

config PD_WAIT_STABLE_TIMER
	int "The timer to wait X ms to setup the PD chip"
	default 0
	help
	    EC should wait X ms the PD chip run in stable mode then start to
		communicate.

config PD_CCG6_CUSTOMIZE_BATT_MESSAGE
	bool "Enable CCG6 Customize battery response"
	default n
	depends on PD_CHIP_CCG6
	depends on PLATFORM_EC_BATTERY
	help
	    Enable customize battery response for GRL test, EC will write specific
		register 0x4f to PD for GET_BATTERY_CAP and GET_BATTERY_STATUS.

config PD_CCG8_CYPD_POWER_STATE_G3_SUPPORT
	bool "PD supports power state G3"
	default y
	depends on PD_CHIP_CCG8
	help
		The PD SDK source code defines CY_PDSTACK_SYS_PWR_STATE_G3. However,
		the HPI firmware only checks the first two bits. Use this config to
		distinguish between different PD firmware behaviors.

config PLATFORM_EC_PD_CHIP_MAX_COUNT
	int "The maximum PD chips"
	default 2
	help
		We would like to design the PD function more flexible.
		Use this configuration to set the maximum PD chip with mainboard design.

config PD_CCG8_CUSTOMIZE_BATT_MESSAGE
	bool "Enable CCG8 Customize battery response"
	default n
	depends on PD_CHIP_CCG8
	help
	    Enable customize battery response for GRL test, EC will write specific
		register 0x4f to PD for GET_BATTERY_CAP and GET_BATTERY_STATUS.

config PD_COMMON_VBUS_CONTROL
	bool "Enable CCG common vbus control"
	help
		Enable Cypress CCG common vbus control, if not enable please modify
		board_set_active_charge_port at board for customize vbus control.

config PLATFORM_EC_PD_RESET_BEFORE_EC_REBOOT
	bool "Enable PD reset before rebooting the EC"
	default n
	help
		Enable this as a workaround to reset the PD before a firmware update.
		This ensures the PD status is reset to normal mode.

config PLATFORM_EC_PD_IGNORE_EXIT_RT_MODE
    bool "Ignore exit retimer update mode"
    help
        The new CYPD SDK performs error recovery once the PD chip receives the
        exit retimer update mode signal. This can cause a system power drop
        when the user updates the retimer in standalone mode.

# CCG vendor-specific register
config CCG_DPM_CMD_REG
	hex "CCG DPM Command Register"
	default 0x0040 if CHIPSET_AMD
	default 0x004B if CHIPSET_INTEL

config CCG_MUX_CFG_REG
	hex "CCG MUX Config Register"
	default 0x0041 if CHIPSET_AMD
	default 0x004D if CHIPSET_INTEL

config CCG_DEINIT_PORT_REG
	hex "CCG De-init Port Register"
	default 0x0042 if CHIPSET_AMD
	default 0x004E if CHIPSET_INTEL

config PLATFORM_SIMPLE_VERSION_SHIFT_IDX
	int "Shift idx for return commit id to BIOS"
	default 18
	help
		The simple version will take commit from EC_IMAGE_RO, than we should shift
		idx for retrieve commit id from, for example "marigold-1.00-7f2d422" (15 shift)

config PLATFORM_MULTI_LED_FREQ
	int "set the framework multifunction led flash frequency"
	default 1000
	help
		The multifunction LED flash frequency is different on each project, use this
		to configure the frequency. (unit milli period)

config PLATFORM_IGNORED_TOUCHPAD_ID
	bool "Enable ingonre check Touchpad board id"
	default n
	help
		Enable this option if Touchpad board ID not current at the build phase
		or need test others TP for verify.

config PLATFORM_CHASSIS_OPEN_SWITCH
	bool "Enable the project to support chassis open switch feature"
	default y
	help
		The chassis open switch will detect the chassis open state, and perform the
		following action:
		1. If open, control multifunctional LED
		2. If open, shutoff mainboard power at G3 state within 3 seconds
		3. Record the chassis toggle counts

		The project should define a GPIO label named gpio_chassis_open_l, with
		chassis_interrupt_handler configured as the handler.

config PLATFORM_PRIVACY_DEVICE_CHECK
	bool "Check the status of camera and microphone"
	default y
	help
		If enabled, the privacy device which camera and microphone
		status can be found via a host
		command (EC_CMD_PRIVACY_SWITCHES_CHECK_MODE).

config PLATFORM_EC_HID
	bool "Generic hid driver for the framework project"
	depends on DT_HAS_CROS_EC_I2C_TARGET_HID_ENABLED
	default y
	help
	  This option enables the hid driver.
	  EC is an i2c slave device and report the data (e.g ALS sensor value)
	  to the host via hid over i2c protocaol.

config SELECT_3A_TYPEC_OUTPUT_CURRENT
	bool "EC will select one type-c port to output 3A current"
	default y
	help
		Default set all type-c port to output 1.5A current. And select
		the first PD device to provide 3A current.

config PD_ERROR_RECOVERY
	bool "enable to send the error recovery command to PD"
	default y
	help
		If the retimer power rail is differernt with PD chip, EC may need
		to send the error recovery command to PD during powering up the
		system.

config PWRSEQ_AP_BOOT_DELAY
	int "Set the default ap_boot_delay value"
	default 0
	help
		Some platform asserts the slp_s4/slp_s5 more than 1 second. If set the
		ap_boot_delay to 0 may hard to power on the system. Use this configuration
		to allow the project to change the timer.

# Driver configuration
config PLATFORM_EC_WAKE_ON_LAN
	bool "system can be waked on lan"
	default y
	depends on DT_HAS_CROS_EC_WAKE_ON_LAN_ENABLED
	help
	  Enable the wake on lan feature.
	  User can enable/disable the wake on lan feature in the
	  setup menu.

config SHORT_HIBERNATE_TIMER
	int "The timer to enter hibernate when the C cover is open"
	default 2
	help
		When the laptop C cover is opened, we need to turn off the power as soon as
		possible. The default value is 2 seconds.

config CHARGER_DYNAMIC_ACOK_REFERENCE
	bool "Enabled to control the charger acok reference dynamically"
	default n
	help
		When the mainboard connects the 15W type-c source, the charger input
		voltage will drop to less than 4V, if we fix the acok reference to lower
		voltage, the system battery icon will show the charging even if the adapter
		is disconnected. Control the charger acok reference dynamically can fix this
		issue.

config PLATFORM_EC_CHARGER_RAA489300
	bool "Select renesas raa489300 chip"
	default n
	help
		Framework project which uses the renesas raa489300 chip.
		Enable raa489300 feature.

config PLATFORM_EC_PECI_TJMAX
	int "Static INTEL CPU TjMax Value (degrees C)"
	default 110
	help
		Specify to set INTEL CPU the Tjunction Max temperature in degrees Celsius.

module = FRAMEWORK
