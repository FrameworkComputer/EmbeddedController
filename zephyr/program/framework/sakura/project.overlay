#include "../marigold/adc.dtsi"
#include "../marigold/battery.dtsi"
#include "../marigold/fan.dtsi"
#include "../marigold/gpio.dtsi"
#include "../marigold/i2c.dtsi"
#include "../marigold/interrupts.dtsi"
#include "../marigold/keyboard.dtsi"
#include "../marigold/led_pins.dtsi"
#include "../marigold/led_policy.dtsi"
#include "../marigold/overlay.dtsi"
#include "../marigold/power_signal.dtsi"


/ {
	aliases {
		/delete-property/ gpio-mux-uart-flip;
		gpio-tp-board-id-detect = &gpio_tp_board_id_pug;
		gpio-module-power = &gpio_module_pwr_on;
	};

	named-gpios {
		compatible = "named-gpios";
		/delete-node/ mux_sub_uart_flip;
		/delete-node/ ec_beep;
		/delete-node/ power_vr_id;
		/delete-node/ me_en;
		/delete-node/ unused-pins;

		gpio_tp_board_id_pug: tp_board_id_pug {
			gpios = <&gpiod 5 GPIO_OUTPUT_LOW>;
		};

		gpio_ec_ssd_pwr_en: ec_ssd_pwr_en {
			gpios = <&gpio4 2 GPIO_OUTPUT_LOW>;
		};
		gpio_ec_amp_pwr_en: ec_amp_pwr_en {
			gpios = <&gpio3 3 GPIO_OUTPUT_LOW>;
		};
		gpio_ec_ts_pwr_en: ec_ts_pwr_en {
			gpios = <&gpio3 6 GPIO_OUTPUT_LOW>;
		};
		gpio_ec_fp_led_pwr_en: ec_fp_led_pwr_en {
			gpios = <&gpiof 4 GPIO_OUTPUT_LOW>;
		};
		gpio_me_en_l: me_en_l {
			gpios = <&gpio7 4 GPIO_ODR_HIGH>;
		};
		gpio_ec_on_5v: ec_on_5v {
			gpios = <&gpiod 7 GPIO_OUTPUT_LOW>; /* Reserved */
		};
	};

	named-adc-channels {
		compatible = "named-adc-channels";

		adc_speaker: speaker {
			enum-name = "ADC_SPEAKER_ID";
			io-channels = <&adc0 1>;
		};
	};

	named-temp-sensors {
		compatible = "cros-ec,temp-sensors";
		/**
		 * For EVT SMT, set the fan_max to the environment temperature to
		 * turn the fan on full.
		 */
		temp_sensor_cpu: cpu-f75303 {
			temp_host_high = <88>;
			temp_host_halt = <98>;
			temp_host_release_high = <78>;
			temp_fan_off = <15>;
			temp_fan_max = <20>;
			power-good-pin = <&gpio_slp_s3_l>;
			sensor = <&cpu_f75303>;
		};
	};
};

&i2c3_0 {
	/delete-node/ isl9241@9;

	charger: raa489108@9 {
		compatible = "intersil,isl923x";
		status = "okay";
		reg = <0x9>;
	};
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc0_chan0_gp45
		     &adc0_chan1_gp44
		     &adc0_chan4_gp41
		     &adc0_chan5_gp37
		     &adc0_chan7_gpe1
		     &adc0_chan8_gpf1
		     &adc0_chan9_gpf0>;
	pinctrl-names = "default";
};
