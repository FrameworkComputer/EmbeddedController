			gpios = <&gpio6 2 (GPIO_INPUT)>;
		};
		gpio_adp_cntrl: std_adp_cntrl: adp_cntrl {
			gpios = <&gpio6 6 (GPIO_OUTPUT | GPIO_ACTIVE_HIGH)>;
		};
		/* Power sequencing signal needed by fan driver */
		gpio_all_sys_pwrgd: all_sys_pwrgd {
			gpios = <&gpio6 3 (GPIO_INPUT)>;
			enum-name = "GPIO_PG_EC_ALL_SYS_PWRGD";
			no-auto-init;
		};
		gpio_amp_mute_odl: amp_mute_odl {
			gpios = <&gpiod 1 (GPIO_OUTPUT | GPIO_OPEN_DRAIN | GPIO_ACTIVE_HIGH |
						GPIO_OUTPUT_INIT_HIGH | GPIO_OUTPUT_INIT_LOGICAL |
						GPIO_VOLTAGE_1P8)>;
		};
		gpio_ccd_mode_odl: ccd_mode_odl {
