			// signal name was manually overriden from "ec_mech_pwr_btn_l"
			gpios = <&gpio0 0 (GPIO_INPUT)>;
			enum-name = "GPIO_POWER_BUTTON_L";
		};
		gpio_pca_int_l: pca_int_l {
			gpios = <&gpiod 3 (GPIO_INPUT)>;
		};
		gpio_slp_a_l: slp_a_l {
			gpios = <&gpioc 1 (GPIO_INPUT)>;
		};
		gpio_slp_s3_ls: slp_s3_ls {
			gpios = <&gpio9 4 (GPIO_INPUT)>;
		};
		gpio_slp_s4_ls_l: slp_s4_ls_l {
			gpios = <&gpioa 6 (GPIO_INPUT)>;
		};
		gpio_tablet_mode_l: tablet-mode {
			gpios = <&gpio7 4 (GPIO_INPUT | GPIO_VOLTAGE_1P8)>;
			enum-name = "GPIO_TABLET_MODE_L";
		};
		gpio_usb_pd_int_ls_odl: usb_pd_int_ls_odl {
			gpios = <&gpiof 0 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;
		};
		gpio_virtual_battery: virtual_battery {
			gpios = <&gpio8 0 (GPIO_INPUT)>;
		};
		gpio_wp_odl: wp_odl {
			// signal name was manually overriden from "ec_soc_rtcrst_odl"
			gpios = <&gpioc 7 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;
		};

		/* Set ISH/sensor I2C bus (i2c5_0) voltage thresholds to 1.8V.
		 * These are not actually GPIOs and will be taken over by the
		 * I2C controller. */
		ec_i2c_sensor_scl {
			gpios = <&gpio3 3 (GPIO_INPUT | GPIO_VOLTAGE_1P8)>;
		};
		ec_i2c_sensor_sda {
			gpios = <&gpio3 6 (GPIO_INPUT | GPIO_VOLTAGE_1P8)>;
		};
	};

	unused-pins {
		compatible = "unused-gpios";
		unused-gpios =
			/* BGA_PINF6 - unused 1.8V I2C bus - pull down to avoid
			 * voltage level issues if this AIC is connected to a
			 * different base RVP board */
			<&gpiof 2 (GPIO_INPUT | GPIO_PULL_DOWN)>,
			/* BGA_PINF5 - unused 1.8V I2C bus - pull down to avoid
			 * voltage level issues if this AIC is connected to a
			 * different base RVP board */
			<&gpiof 3 (GPIO_INPUT | GPIO_PULL_DOWN)>;
	};
};

