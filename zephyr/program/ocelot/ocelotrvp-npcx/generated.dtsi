						GPIO_OUTPUT_INIT_LOGICAL)>;
		};
		gpio_ec_imu_int_l: ec_imu_int_l {
			gpios = <&gpio6 7 (GPIO_INPUT | GPIO_VOLTAGE_1P8)>;
		};
