#include <dt-bindings/battery.h>


/* Only for BASE DETECT to work; will be removed when LB is ready. */
/ {
	pwmleds {
		compatible = "pwm-leds";

		/* NOTE: &pwm number needs same with channel number */
		led_power_red: ec_led1_odl {
			pwms = <&pwm0
				PWM_CHANNEL_0
				PWM_HZ(324)
				PWM_POLARITY_NORMAL>;
		};
	};

	led_pins: pwm-led-pins {
		compatible = "cros-ec,pwm-led-pins";

		battery_led: battery-led {
			led-id = "EC_LED_ID_BATTERY_LED";
			led-pwms = <&led_power_red>;

			battery_led_off: color-power-off {
				led-color = "LED_OFF";
				led-values = <0>;
			};

			battery_led_red: color-power-red {
				led-color = "LED_RED";
				led-values = <100>;
			};
		};
	};

	led-colors {
		compatible = "cros-ec,led-policy";
		led-pins = <&led_pins>;

		sysrq-alias = "EC_LED_ID_BATTERY_LED";
		sysrq-led-control-color = "LED_RED";

		recovery-hw-reinit-alias = "EC_LED_ID_BATTERY_LED";
		recovery-hw-reinit-led-control-color = "LED_RED";

		/* Add this for prevent print storm */
		power-state-charge-lvl-1 {
			charge-state = "LED_PWRS_CHARGE";
			batt-lvl = <BATTERY_LEVEL_EMPTY 100>;
			battery-led {
				led-id = "EC_LED_ID_BATTERY_LED";
				color-0 {
					led-color = <&battery_led_off>;
				};
			};
		};

		power-state-near-full {
			charge-state = "LED_PWRS_CHARGE_NEAR_FULL";
			battery-led {
				led-id = "EC_LED_ID_BATTERY_LED";
				color-0 {
					led-color = <&battery_led_off>;
				};
			};
		};

		power-state-discharge {
			charge-state = "LED_PWRS_DISCHARGE";
			battery-led {
				led-id = "EC_LED_ID_BATTERY_LED";
				color-0 {
					led-color = <&battery_led_off>;
				};
			};
		};

		power-state-idle {
			charge-state = "LED_PWRS_IDLE";
			battery-led {
				led-id = "EC_LED_ID_BATTERY_LED";
				color-0 {
					led-color = <&battery_led_off>;
				};
			};
		};

		power-state-forced-idle {
			charge-state = "LED_PWRS_FORCED_IDLE";
			battery-led {
				led-id = "EC_LED_ID_BATTERY_LED";
				color-0 {
					led-color = <&battery_led_off>;
				};
			};
		};

		power-state-error {
			charge-state = "LED_PWRS_ERROR";
			battery-led {
				led-id = "EC_LED_ID_BATTERY_LED";
				color-0 {
					led-color = <&battery_led_off>;
				};
			};
		};
	};
};

&pwm0 {
	status = "okay";
	prescaler-cx = <PWM_PRESCALER_C4>;
	pinctrl-0 = <&pwm0_gpa0_default>;
	pinctrl-names = "default";
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi_ssce0_default &spi_smosi_default>;
	pinctrl-names = "default";

	spi0_dev0: spi0_dev@0 {
		reg = <0>;
		chain-length = <5>;
		reset-delay = <205>;
		spi-max-frequency = <6000000>;
		bits-per-symbol = <8>;
		spi-one-frame = <0xF8>;        // 0b11111000 for a '1' bit
		spi-zero-frame = <0xC0>;       // 0b11000000 for a '0' bit
	};
};
