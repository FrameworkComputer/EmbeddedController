config PLATFORM_EC_ADSP_CHARGE_MANAGER
	bool "ADSP charge manager support"
	select PLATFORM_EC_BATTERY_STATUS_CUSTOM
	help
	  Enable ADSP charge manager support, including I2C port switching
	  between controller and target modes on chipset state transitions.
	  Note: This charge manager functionality is achieved via ADSP
	  communications.

if PLATFORM_EC_ADSP_CHARGE_MANAGER

config ADSP_COMMS_STACK_SIZE
	int "ADSP comms task stack size"
	default 1024
	help
	  The stack size for the ADSP communications task.

config ADSP_COMMS_PRIORITY
	int "ADSP comms task priority"
	default 5
	help
	  The priority for the ADSP communications task.

config ADSP_COMMS_MSGQ_SIZE
	int "ADSP comms message queue size"
	default 16
	help
	  The number of messages that can be stored in the ADSP communications
	  message queue.

endif # PLATFORM_EC_ADSP_CHARGE_MANAGER
