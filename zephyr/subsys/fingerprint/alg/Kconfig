config FP_FPC_BEP_ALGORITHM
	bool "FPC BEP matching algorithm"
	default y if FINGERPRINT_SENSOR_FPC1025
	help
	  Enable FPC BEP matching algorithm. To work properly, FPC private
	  library is required.

config FP_ELAN_ELAN80SERIES_ALGORITHM
	  bool
	  help
	    Enable ELAN ELAN80SERIES matching algorithm. To work properly, ELAN
		private library is required.

config FP_ELAN_ELAN80SG_ALGORITHM
      bool "ELAN ELAN80SG matching algorithm"
      default y if FINGERPRINT_SENSOR_ELAN80SG
      select FP_ELAN_ELAN80SERIES_ALGORITHM
      help
        Enable ELAN ELAN80SG matching algorithm. To work properly, ELAN
        private library is required.

config FP_ELAN_ELANI80SA_ALGORITHM
      bool "ELAN ELANI80SA matching algorithm"
      default y if FINGERPRINT_SENSOR_ELANI80SA
      select FP_ELAN_ELAN80SERIES_ALGORITHM
      help
        Enable ELAN ELANI80SA matching algorithm. To work properly, ELAN
        private library is required.

config FP_FPC_LIBFP_ALGORITHM
	bool "FPC LIBFP matching algorithm"
	default y if FINGERPRINT_SENSOR_FPC1145
	help
	  Enable FPC LIBFP matching algorithm. To work properly, FPC private
	  library is required.

config FP_EGIS_EGIS630_ALGORITHM
	bool "EGIS EGIS630 matching algorithm"
	default y if FINGERPRINT_SENSOR_EGIS630
	help
	  Enable EGIS EGIS630 matching algorithm. To work properly, EGIS private
	  library is required.

config FP_EGIS_EGIS660_ALGORITHM
	bool "EGIS_EGIS660 matching algorithm"
	default y if FINGERPRINT_SENSOR_EGIS660
	help
	  Enable EGIS EGIS660 matching algorithm. To work properly, EGIS private
	  library is required.

config FP_FT98XX_ALGORITHM
	bool "FT98XX matching algorithm"
	default y if FINGERPRINT_SENSOR_FT98XX
	help
	  Enable Focaltech FT98XX matching algorithm. To work properly, Focaltech
	  private library is required.

config FP_ALGORITHM_TEMPLATE_SIZE
	int "Size of template size"
	default 5092 if FINGERPRINT_SENSOR_FPC1025 && FP_FPC_BEP_ALGORITHM
	default 47552 if FINGERPRINT_SENSOR_FPC1145 && FP_FPC_LIBFP_ALGORITHM
	default 20480 if FINGERPRINT_SENSOR_EGIS630 && FP_EGIS_EGIS630_ALGORITHM
	default 18004 if FINGERPRINT_SENSOR_EGIS660 && FP_EGIS_EGIS660_ALGORITHM
	default 19320 if FINGERPRINT_SENSOR_ELAN80SG && FP_ELAN_ELAN80SG_ALGORITHM
	default 34800 if FINGERPRINT_SENSOR_ELANI80SA && FP_ELAN_ELANI80SA_ALGORITHM
	default 86016 if FINGERPRINT_SENSOR_FT98XX && FP_FT98XX_ALGORITHM
	default 0
	help
	  Constant value corresponding to the maximum template size.
	  Client template memory allocation must have this size.
	  This includes extra memory for template update.

	  For example, for FPC1025 sensor template size is 5092 bytes which
	  consists of template size + alignment padding + size of template
	  size variable.

config FP_MAX_FINGER_COUNT
	  int "Maximum number of loaded finger templates"
	  default 5 if FINGERPRINT_SENSOR_FPC1025 && FP_FPC_BEP_ALGORITHM
	  default 5 if FINGERPRINT_SENSOR_FPC1145 && FP_FPC_LIBFP_ALGORITHM
	  default 3 if FINGERPRINT_SENSOR_EGIS630 && FP_EGIS_EGIS630_ALGORITHM
	  default 3 if FINGERPRINT_SENSOR_EGIS660 && FP_EGIS_EGIS660_ALGORITHM
	  default 3 if FINGERPRINT_SENSOR_ELAN80SG && FP_ELAN_ELAN80SG_ALGORITHM
	  default 3 if FINGERPRINT_SENSOR_ELANI80SA && FP_ELAN_ELANI80SA_ALGORITHM
	  default 3 if FINGERPRINT_SENSOR_FT98XX && FP_FT98XX_ALGORITHM
	  default 5
	  help
		Max number of templates stored / matched against. This limit comes
		from memory constraints and matching time.

config HAVE_BEP_PRIVATE_DRIVER
	bool
	default n
	help
	  If enabled, it indicates that BEP private driver is present.

config HAVE_LIBFP_PRIVATE_DRIVER
	bool
	default n
	help
	  If enabled, it indicates that LIBFP private driver is present.

config HAVE_EGIS630_PRIVATE_ALGORITHM
	bool
	default n
	help
	  If enabled, it indicates that EGIS630 private algorithm is present.

config HAVE_EGIS660_PRIVATE_ALGORITHM
	bool
	default n
	help
	  If enabled, it indicates that EGIS660 private algorithm is present.

config HAVE_ELAN80SERIES_PRIVATE_ALGORITHM
	bool
	help
	  If enabled, it indicates that ELAN80SERIES private algorithm is present.

config HAVE_FT_LOCKER_PRIVATE_ALGORITHM
	bool
	default n
	help
	  If enabled, it indicates that focaltech private algorithm is present.

config LIBFP_PRIVATE_DRIVER_HEAP_SIZE
	int "Size of heap for FPC1145 driver"
	depends on HAVE_LIBFP_PRIVATE_DRIVER
	default 393216
	help
	  Size of heap to be used by FPC private library. The default vaule has
	  been established experimentally.
