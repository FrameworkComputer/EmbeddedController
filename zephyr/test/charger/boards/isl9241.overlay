 #include <board-overlays/native_sim.dts>
 #include <usbc-policy.dtsi>

&i2c0 {

	/delete-node/ isl923x@9;

	charger: isl9241@9 {
		compatible = "intersil,isl9241";
		status = "okay";
		reg = <0x9>;
	};
};
