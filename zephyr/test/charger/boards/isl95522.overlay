 #include <board-overlays/native_sim.dts>
 #include <usbc-policy.dtsi>

&i2c0 {

	/delete-node/ isl923x@9;

	charger: isl95522@9 {
		compatible = "intersil,isl95522";
		status = "okay";
		reg = <0x9>;
		minimum-charging-mv = <15000>;
	};
};
