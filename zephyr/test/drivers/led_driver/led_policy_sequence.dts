/ {
	led-colors {
		compatible = "cros-ec,led-policy";

		/* Label 2 triggers Infinite Loop (cycle-count = 0) */
		seq-infinite {
			board-led-alt-policy-label = <2>;

			battery-led-logic {
				led-id = "EC_LED_ID_BATTERY_LED";
				cycle-count = <0>;
				color-0 {
					led-color = <&battery_led_blue>;
					period-ms = <250>;
				};
				color-1 {
					led-color = <&battery_led_white>;
					period-ms = <250>;
				};
			};
		};

		/* Label 3 triggers Run-Once (cycle-count = 1) */
		seq-once {
			board-led-alt-policy-label = <3>;

			battery-led-logic {
				led-id = "EC_LED_ID_BATTERY_LED";
				cycle-count = <1>;
				color-0 {
					led-color = <&battery_led_white>;
					period-ms = <250>;
				};
				color-1 {
					led-color = <&battery_led_blue>;
					period-ms = <250>;
				};
			};
		};
	};
};
