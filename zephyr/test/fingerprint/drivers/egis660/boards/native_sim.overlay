#include <board-overlays/native_sim.dts>
#include <cros/binman.dtsi>

#define EGIS660_COMMON_IMAGE_PROPS \
	width = <96>; \
	height = <100>; \
	bits-per-pixel = <8>; \
	frame-size = <9980>; \
	image-data-offset-bytes = <172>; \
	v4l2-pixel-format = "V4L2_PIX_FMT_GREY";

/ {
	chosen {
		cros-fp,fingerprint-sensor = &egis660;
		cros-ec,flash-controller = &cros_flash;
	};

	aliases {
		gpio-wp = &gpio_wp_l;
	};

	named-gpios {
		gpio_wp_l: wp_l {
			gpios = <&gpio0 0 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;
		};
	};

	soc {
		egis660_apns_data: egis660-apns-data@100000 {
			compatible = "cros-ec,apns-storage";
			reg = <0 0x100000 DT_SIZE_K(64)>;
		};
	};

	cros_flash: cros-flash@0 {
		compatible = "cros-ec,flash-emul";
		reg = <0x00000000 DT_SIZE_M(2)>;
	};
};

/* Configure existing simulated flash from native_sim.dts */
&flash0 {
	erase-block-size = <0x1000>;
	write-block-size = <256>;
	reg = <0x00000000 DT_SIZE_K(2048)>;
};

&spi0 {
	egis660: egis660@0 {
		compatible = "egis,egis660";
		reg = <0>;
		spi-max-frequency = <4000000>;

		configs {
			compatible = "fingerprint-image-frame-params";
			config0 {
				EGIS660_COMMON_IMAGE_PROPS
				capture-type = "FINGERPRINT_CAPTURE_TYPE_VENDOR_FORMAT";
			};
			config1 {
				EGIS660_COMMON_IMAGE_PROPS
				capture-type = "FINGERPRINT_CAPTURE_TYPE_SIMPLE_IMAGE";
			};
			config2 {
				EGIS660_COMMON_IMAGE_PROPS
				capture-type = "FINGERPRINT_CAPTURE_TYPE_PATTERN0";
			};
			config3 {
				EGIS660_COMMON_IMAGE_PROPS
				capture-type = "FINGERPRINT_CAPTURE_TYPE_PATTERN1";
			};
			config4 {
				EGIS660_COMMON_IMAGE_PROPS
				capture-type = "FINGERPRINT_CAPTURE_TYPE_RESET_TEST";
			};
		};

		irq-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		reset-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
	};
};
